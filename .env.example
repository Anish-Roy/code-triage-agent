# Copy to .env for local development. Never commit .env.

# GitHub App (required for real webhook processing, not for health/validate)
CTA_GITHUB_APP_ID=
CTA_GITHUB_APP_PRIVATE_KEY=
CTA_GITHUB_INSTALLATION_ID=
CTA_GITHUB_WEBHOOK_SECRET=

# LLM provider (resolved in Phase 2, unused in Phases 0-1)
CTA_LLM_PROVIDER=anthropic
CTA_LLM_MODEL=
CTA_LLM_API_KEY=

# Paths
CTA_CONFIG_DIR=config
CTA_DATABASE_PATH=var/triage.db
CTA_SNAPSHOT_ROOT=var/snapshots
CTA_EVENT_ROOT=var/events

# Behaviour
CTA_DRY_RUN=true
CTA_REPLAY_MODE=false
CTA_AUTO_MERGE_MEMORY=false

# Repo-specific redaction regexes (JSON list); applied before snapshots/prompts
CTA_REDACTION_PATTERNS=[]

# Budget defaults
CTA_MAX_STEPS=12
CTA_MAX_COST_USD=0.50
CTA_MAX_SECONDS=180

# Logging
CTA_LOG_LEVEL=INFO
